# 複製這個檔案為 .env 並填入你的實際值
# 請勿將 .env 檔案提交到版本控制

# ---- 應用程式 ----
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-string
PORT=3000

# ---- 資料庫 ----
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=my_database
# DB_USER=my_user
# DB_PASSWORD=

# ---- 外部服務 / API ----
# OPENAI_API_KEY=
# MAPBOX_TOKEN=